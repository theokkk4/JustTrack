# Copy this file to .env for local development. Never commit .env.
#
# The app itself needs no keys: food search runs on a bundled USDA database and
# Open Food Facts, and everything you log stays on your device.

# --- Server only: the Vercel function behind the photo scanner (api/analyze-meal.ts) ---
# Set these in Vercel → Project → Settings → Environment Variables. Never put them in
# the app, never prefix them with EXPO_PUBLIC_, and never commit them.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# --- Client (optional) ---
# The web app calls /api on its own origin. A native build needs the deployed URL, e.g.
# https://justtrack.vercel.app
EXPO_PUBLIC_API_BASE_URL=

# --- Native builds only (TestFlight / personal builds) ---
# When set, the app asks Gemini directly from the device instead of /api/analyze-meal.
# Anyone who unpacks the build can read it, so keep it to builds you hand out yourself.
# Store it on EAS, never here and never in eas.json:
#   npx eas-cli@latest env:set --name EXPO_PUBLIC_GEMINI_API_KEY --value <key> \
#     --environment production --visibility sensitive --scope project
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional model override for the on-device path.
EXPO_PUBLIC_GEMINI_MODEL=
