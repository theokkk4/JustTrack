# Copy this file to .env and fill in real values. Never commit .env.
#
# Variables prefixed EXPO_PUBLIC_ are bundled into the client app — only put
# values here that are genuinely safe to ship inside the iOS binary.

# --- Client (Expo app) — safe to expose ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only — Supabase Edge Function secrets ---
# These must NEVER be prefixed with EXPO_PUBLIC_ and are never read by the
# Expo app. They exist here only to document what the project needs; the
# values actually get set with:
#   supabase secrets set FATSECRET_CLIENT_ID=... FATSECRET_CLIENT_SECRET=... ANTHROPIC_API_KEY=...
# (see supabase/functions/README.md once Edge Functions are added)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Vision model used by the AI meal scanner (Anthropic Claude). Server-side only.
ANTHROPIC_API_KEY=
